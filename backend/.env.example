# LLM provider selection: groq | openai | anthropic | azure_openai
LLM_PROVIDER=groq

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only needed when LLM_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional overrides (defaults live in app/config.py)
# CONFIDENCE_THRESHOLD=0.6
# COMPLAINT_FOLLOWUP_HOURS=2
# SERVICE_REQUEST_SLA_HOURS=24
